# Copy to .env for local dev: `cp .env.example .env`. These are required —
# jobs fail fast on startup if DATABASE_URL or NATS_URL is unset. The values
# below match docker-compose.yml, so no edits are needed for the default stack.
DATABASE_URL=postgres://homeserver:homeserver@localhost:5433/homeserver
NATS_URL=nats://localhost:4222
RUST_LOG=info
