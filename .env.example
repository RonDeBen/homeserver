# Copy to .env for local dev: `cp .env.example .env`. These are required —
# jobs fail fast on startup if DATABASE_URL or NATS_URL is unset. The values
# below match docker-compose.yml, so no edits are needed for the default stack.
DATABASE_URL=postgres://homeserver:homeserver@localhost:5433/homeserver
NATS_URL=nats://localhost:4222
RUST_LOG=info

# Optional: only needed if you enable the `ticketmaster` calendar source in
# deploy/sources.toml. Free key from https://developer.ticketmaster.com/.
# TICKETMASTER_API_KEY=

# Gateway (web dashboard + JSON API). Auth is pluggable (crates/common/src/auth.rs):
#   AUTH_MODE=trusted  -> trust every request; for a private-network deploy
#                         (Tailscale tailnet / trusted LAN). This is the default.
#   AUTH_MODE=token    -> require `Authorization: Bearer <AUTH_TOKEN>`; use when
#                         exposing the gateway beyond a trusted network (behind TLS).
# AUTH_MODE=trusted
# AUTH_TOKEN=
# Where the gateway binds (default 0.0.0.0:8080). Set to 127.0.0.1:8080 to bind
# loopback-only, e.g. behind a reverse proxy.
# GATEWAY_ADDR=0.0.0.0:8080
